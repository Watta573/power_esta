DB_URL=jdbc:postgresql://localhost:5432/power_esta
DB_USERNAME=<db_username>
DB_PASSWORD=<db_password>

JWT_SECRET=<min_32_chars_random_secret>
JWT_ISSUER=biblioteca
JWT_EXPIRATION_MINUTES=240
JWT_REFRESH_DAYS=7

MAIL_USERNAME=<smtp_email>
MAIL_PASSWORD=<smtp_app_password>
MAIL_MOCK=false

# CinetPay (https://cinetpay.com -> Mon compte -> API)
CINETPAY_API_KEY=<votre_api_key_cinetpay>
CINETPAY_SITE_ID=<votre_site_id_cinetpay>
BACKEND_URL=http://localhost:8080
# Mettre false en dev local (ngrok ne fait pas partie des IPs CinetPay)
CINETPAY_IP_WHITELIST=false
